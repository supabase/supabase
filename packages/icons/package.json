{
  "name": "icons",
  "main": "./src/icons/index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:icons": "node ./scripts/validateIcons.mjs && build-icons --templateSrc=./scripts/exportTemplate.mjs --renderUniqueKey --iconFileExtension=.ts --exportFileName=index.ts",
    "test": "node --test ./scripts/validateIcons.test.mjs",
    "typecheck": "tsrs --noEmit --tsBuildInfoFile node_modules/.cache/tsrs.tsbuildinfo",
    "validate:icons": "node ./scripts/validateIcons.mjs",
    "clean": "rimraf .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@typescript/native": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "@supabase/build-icons": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
