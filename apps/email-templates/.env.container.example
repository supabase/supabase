DENO_VERSION=2.4.3
TEMPLATES_IMAGE=ghcr.io/alazabdev/email-templates
TEMPLATES_IMAGE_TAG=local
TEMPLATES_HOST_PORT=8080
MAX_BODY_BYTES=262144
ALLOWED_ORIGINS=

# Rendering is enabled. Actual delivery remains disabled until explicitly changed.
ENABLE_SEND=false
EMAIL_PROVIDER=resend

# Put real secrets in ./secrets/, never in this file.
RESEND_API_KEY_FILE=/run/secrets/resend_api_key
EMAIL_WEBHOOK_SECRET_FILE=/run/secrets/email_webhook_secret
EMAIL_WEBHOOK_URL=

EMAIL_BRAND_NAME=Alazab
EMAIL_COMPANY_NAME=شركة العزب
EMAIL_LOGO_URL=https://alazab.com/w.gif
EMAIL_SUPPORT_EMAIL=support@alazab.com
EMAIL_WEBSITE_URL=https://alazab.com

EMAIL_FROM_AUTH=auth@alazab.com
EMAIL_FROM_SUPPORT=support@alazab.com
EMAIL_FROM_DEVOPS=devops@alazab.com
EMAIL_FROM_CORE=noreply@alazab.com
EMAIL_FROM_FINANCE=finance@alazab.com
EMAIL_FROM_MAINT=maintenance@alazab.com
EMAIL_FROM_PAYMENTS=billing@alazab.com
EMAIL_FROM_PRODUCTS=products@alazab.com
EMAIL_FROM_PROJECTS=projects@alazab.com
EMAIL_FROM_AI=ai@alazab.com
