{
  "id": "az.payments.receipt.ar.v1",
  "system": "payments",
  "agent": "az-agent-payments",
  "systemName": "المدفوعات",
  "event": "receipt",
  "locale": "ar",
  "version": 1,
  "name": "إرسال إيصال الدفع",
