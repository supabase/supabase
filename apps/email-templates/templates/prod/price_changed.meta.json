  "optional": [
    "reference",
    "message",
    "status_label",
    "status_tone",
    "details",
    "action_url",
    "action_label",
    "secondary_action_url",
    "secondary_action_label",
    "alert_title",
    "alert_message",
    "alert_tone",
    "logo_url",
    "support_email",
    "website_url",
    "preferences_url",
    "footer_note"
  ]
}
