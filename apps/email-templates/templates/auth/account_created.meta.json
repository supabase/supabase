{
  "id": "az.auth.account_created.ar.v1",
  "system": "auth",
  "agent": "az-agent-auth",
  "systemName": "المصادقة",
  "event": "account_created",
  "locale": "ar",
  "version": 1,
  "name": "تم إنشاء الحساب",
  "subject": "{{brand_name}} | تم إنشاء الحساب{{#reference}} - {{reference}}{{/reference}}",
  "preheader": "تم إنشاء الحساب — إشعار صادر من az-agent-auth",
  "senderEnv": "EMAIL_FROM_AUTH",
  "defaultFrom": "auth@alazab.com",
  "defaultBrandName": "Alazab",
  "defaultMessage": "تم تسجيل هذا التحديث بنجاح. يرجى مراجعة البيانات الواردة أدناه والاحتفاظ بالرسالة للرجوع إليها عند الحاجة.",
  "defaultStatusLabel": "مكتمل",
  "defaultStatusTone": "success",
  "defaultActionLabel": "متابعة الإجراء",
  "required": [
    "recipient_name"
  ],
  "optional": [
    "reference",
    "message",
    "status_label",
    "status_tone",
    "details",
    "action_url",
    "action_label",
    "secondary_action_url",
    "secondary_action_label",
    "alert_title",
    "alert_message",
    "alert_tone",
    "logo_url",
    "support_email",
    "website_url",
    "preferences_url",
    "footer_note"
  ]
}
