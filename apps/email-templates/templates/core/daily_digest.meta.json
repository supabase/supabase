{
  "id": "az.core.daily_digest.ar.v1",
  "system": "core",
  "agent": "az-agent-core",
  "systemName": "الوكيل الأساسي",
  "event": "daily_digest",
  "locale": "ar",
  "version": 1,
  "name": "الملخص اليومي",
  "subject": "{{brand_name}} | الملخص اليومي{{#reference}} - {{reference}}{{/reference}}",
  "preheader": "الملخص اليومي — إشعار صادر من az-agent-core",
  "senderEnv": "EMAIL_FROM_CORE",
  "defaultFrom": "noreply@alazab.com",
  "defaultBrandName": "Alazab",
  "defaultMessage": "تم تسجيل تحديث جديد على النظام. يمكنك مراجعة التفاصيل واتخاذ الإجراء المطلوب من خلال الرابط المرفق.",
  "defaultStatusLabel": "تحديث جديد",
  "defaultStatusTone": "info",
  "defaultActionLabel": "فتح مركز العمليات",
  "required": [
    "recipient_name"
  ],
  "optional": [
    "reference",
    "message",
    "status_label",
    "status_tone",
    "details",
    "action_url",
    "action_label",
    "secondary_action_url",
    "secondary_action_label",
    "alert_title",
    "alert_message",
    "alert_tone",
    "logo_url",
    "support_email",
    "website_url",
    "preferences_url",
    "footer_note"
  ]
}
