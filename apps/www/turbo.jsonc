{
  "$schema": "./../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "env": ["GITHUB_TOKEN"],
    },
    // Generated files that tasks downstream of the uncached content tasks read. They're written
    // after turbo starts, so inputs list them in "jit" mode: they're hashed once the content tasks
    // have run, and a cache hit can't restore output built from stale remote content.

    // Fetches remote content (GitHub stars, open job count, the private changelog repo) and
    // writes .generated/, the RSS feeds, the changelog markdown and the .md content bundle. Not
    // cached: the inputs are remote.
    "content:build:core": {
      "cache": false,
      // `next build` rewrites the tracked customers feed. Hashing it would change this task's hash
      // after every build, which feeds into the build's own hash.
      "inputs": ["$TURBO_DEFAULT$", "!public/customers-rss.xml"],
      "passThroughEnv": [
        "CHANGELOG_SYNC_APP_ID",
        "CHANGELOG_SYNC_APP_INSTALLATION_ID",
        "CHANGELOG_SYNC_APP_PRIVATE_KEY",
        "GITHUB_TOKEN",
        // Makes missing changelog credentials an error instead of a warning.
        "VERCEL",
      ],
    },
    // Also refreshes the agent-skills index (a tracked file) from the latest GitHub release.
    "content:build": {
      "dependsOn": ["content:build:core"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!public/customers-rss.xml"],
      "passThroughEnv": ["AGENT_SKILLS_GITHUB_TOKEN", "VERCEL_ENV"],
    },
    "dev": {
      "dependsOn": ["content:build:core"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "content:build:core"],
      "inputs": [
        "$TURBO_DEFAULT$",
        { "mode": "jit", "globs": [".generated/**", "app/api-v2/md/content.generated.ts"] },
      ],
    },
    "build": {
      // docs#build:guides-markdown fetches the federated guides itself (uncached) and writes the
      // guide content and markdown that www reads, so it must run before the inputs are hashed.
      "dependsOn": ["^build", "docs#build:guides-markdown", "content:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/customers-rss.xml",
        ".env*",
        "$TURBO_ROOT$/apps/studio/components/ui/TwoOptionToggle.tsx",
        {
          "mode": "jit",
          "globs": [
            ".generated/**",
            "app/api-v2/md/content.generated.ts",
            "public/rss.xml",
            "public/changelog-rss.xml",
            "public/changelog-rss/**",
            "public/changelog.md",
            "public/changelog/**",
            "public/.well-known/agent-skills/index.json",
            "$TURBO_ROOT$/apps/docs/content/guides/**",
            "$TURBO_ROOT$/apps/docs/public/markdown/guides/**",
          ],
        },
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "ANALYZE",
        "CI",
        "CF_ACCESS_CLIENT_ID",
        "CF_ACCESS_CLIENT_SECRET",
        "HCAPTCHA_SECRET_KEY",
        "NODE_ENV",
        "SENTRY_AUTH_TOKEN",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "LIVE_SUPABASE_COM_SERVICE_ROLE_KEY",
        "CHANGELOG_SYNC_APP_ID",
        "CHANGELOG_SYNC_APP_INSTALLATION_ID",
        "CHANGELOG_SYNC_APP_PRIVATE_KEY",
        "EMAIL_ABUSE_SERVICE_KEY",
        "HUBSPOT_PORTAL_ID",
        "HUBSPOT_ENTERPRISE_FORM_GUID",
        "HUBSPOT_PARTNERSHIP_FORM_GUID",
        "HUBSPOT_PARTNER_INTAKE_FORM_GUID",
        "HUBSPOT_COMPUTE_WAITLIST_FORM_GUID",
        "NOTION_FORMS_API_KEY",
        "OPENAI_API_KEY",
        "EMAIL_REPORT_SLACK_WEBHOOK",
        "LUMA_API_KEY",
        "LUMA_HACKATHONS_API_KEY",
        "NEXT_RUNTIME",
        "SENTRY_DSN_COMMUNITY",
        "NOTION_SUPASQUAD_API_KEY",
        "NOTION_SUPASQUAD_APPLICATIONS_DB_ID",
        "CUSTOMERIO_SITE_ID",
        "CUSTOMERIO_API_KEY",
        "CUSTOMERIO_APP_API_KEY",
        "HUBSPOT_MEETINGS_TOKEN",
        "NOTION_EVENTS_API_KEY",
        "NOTION_EVENTS_DB_ID_ACTUAL",
        "ENABLED_FEATURES_OVERRIDE_DISABLE_ALL",
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".contentlayer/**",
        "public/sitemap.xml",
        "public/sitemap_www.xml",
        "public/customers-rss.xml",
      ],
    },
  },
}
