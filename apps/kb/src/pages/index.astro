---
import { getCollection } from 'astro:content'

import { FeaturedSection } from '../components/FeaturedSection'
import { GuideBrowser } from '../components/GuideBrowser'
import { HomeHero } from '../components/Hero'
import Layout from '../layouts/Layout.astro'
import { padFeatured, toSummary, type FeaturedItem } from '../lib/guides'
import { TOPICS, topicToSlug } from '../lib/topics'

const guides = await getCollection('guides')
const summaries = guides.map(toSummary)
const toTopicItem = (topic: (typeof TOPICS)[number]): Omit<FeaturedItem, 'slot'> => ({
	id: `topic-${topicToSlug(topic.name)}`,
	title: topic.name,
	description: topic.description,
	topics: [topic.name],
	href: `${import.meta.env.BASE_URL}/topics/${topicToSlug(topic.name)}`,
})
const visibleTopics = TOPICS.filter((topic) => topic.visible).map(toTopicItem)
const featuredTopics = padFeatured({
	featured: TOPICS.filter((topic) => topic.visible && topic.pinned).map(toTopicItem),
	fallback: visibleTopics,
})
const featuredGuides = padFeatured({
	featured: guides.filter((guide) => guide.data.pinned).map(toSummary),
	fallback: summaries,
})
---

<Layout description="In-depth guides, tutorials, troubleshooting, and explainers for best practices for Supabase">
	<HomeHero client:load guides={summaries} />
	<div class="flex flex-col gap-20 pb-24 pt-16 sm:gap-24 sm:pt-20">
		<FeaturedSection client:load title="Featured topics" items={featuredTopics} />
		<FeaturedSection client:load title="Featured guides" items={featuredGuides} />
		<GuideBrowser client:load guides={summaries} />
	</div>
</Layout>
