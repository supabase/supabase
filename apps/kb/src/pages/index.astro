---
import { getCollection } from 'astro:content'

import { FeaturedGuides } from '../components/FeaturedGuides'
import { GuideBrowser } from '../components/GuideBrowser'
import { Hero } from '../components/Hero'
import Layout from '../layouts/Layout.astro'
import { padFeatured, type FeaturedGuide, type GuideSummary } from '../lib/guides'
import { TOPICS, topicToSlug } from '../lib/topics'

const guides = await getCollection('guides')
const toSummary = (guide: (typeof guides)[number]): GuideSummary => ({
	id: guide.id,
	title: guide.data.title,
	description: guide.data.description,
	topics: guide.data.topics,
	href: `${import.meta.env.BASE_URL}/guides/${guide.id}`,
})
const summaries = guides.map(toSummary)
const pinnedTopics: Omit<FeaturedGuide, 'slot'>[] = TOPICS.filter((topic) => topic.pinned).map(
	(topic) => ({
		id: `topic-${topicToSlug(topic.name)}`,
		title: topic.name,
		description: topic.description,
		topics: [topic.name],
		href: `${import.meta.env.BASE_URL}/topics/${topicToSlug(topic.name)}`,
		actionLabel: 'Browse guides',
	})
)
const featured = padFeatured({ featured: pinnedTopics, fallback: summaries })
---

<Layout title="Home" description="In-depth guides, tutorials, and explainers for best practices for Supabase databases.">
	<Hero client:load guides={summaries} />
	<div class="flex flex-col gap-20 pb-24 pt-16 sm:gap-24 sm:pt-20">
		<FeaturedGuides client:load guides={featured} />
		<GuideBrowser client:load guides={summaries} />
	</div>
</Layout>
