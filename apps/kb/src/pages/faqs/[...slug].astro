---
import { getCollection, render } from 'astro:content'
import { Admonition } from 'ui-patterns/Admonition'

import ArticleLayout from '../../layouts/ArticleLayout.astro'
import { breadcrumbListSchema, canonicalUrl, faqPageSchema, KB_BASE_URL } from '../../lib/json-ld'

export async function getStaticPaths() {
	const faqs = await getCollection('faqs')
	return faqs.map((faq) => ({
		params: { slug: faq.id },
		props: { faq },
	}))
}

const { faq } = Astro.props
const { title, topics, lastEdited } = faq.data
const { Content } = await render(faq)

// faq.filePath is relative to the kb app root, e.g. "src/content/faqs/auth/foo.mdx"
const viewGitHubLink = `https://github.com/supabase/supabase/blob/master/apps/kb/${faq.filePath}`

const url = canonicalUrl(Astro.url.pathname)
const jsonLd = [
	faqPageSchema({ question: title, answerMarkdown: faq.body ?? '', dateModified: lastEdited }),
	breadcrumbListSchema([
		{ name: 'Knowledge Base', url: KB_BASE_URL },
		{ name: title, url },
	]),
]
---

<ArticleLayout title={title} topics={topics} viewGitHubLink={viewGitHubLink} lastEdited={lastEdited} jsonLd={jsonLd}>
	<Content components={{ Admonition }} />
</ArticleLayout>
