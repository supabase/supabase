---
import { getCollection } from 'astro:content'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList } from 'ui'

import { GuideBrowser } from '../../components/GuideBrowser'
import { Hero } from '../../components/Hero'
import Layout from '../../layouts/Layout.astro'
import { toSummary, toTroubleshootingSummary } from '../../lib/guides'
import { TOPICS, topicToSlug } from '../../lib/topics'

export async function getStaticPaths() {
	const guides = (await getCollection('guides')).map(toSummary)
	const troubleshooting = (await getCollection('troubleshooting')).map(toTroubleshootingSummary)

	// One page per topic in TOPICS — not just topics a guide already uses —
	// so every link on the "Topics" nav resolves instead of 404ing.
	return TOPICS.map((topic) => ({
		params: { topic: topicToSlug(topic.name) },
		props: {
			topic: topic.name,
			description: topic.description,
			guides: guides.filter((guide) => guide.topics.includes(topic.name)),
			troubleshooting:
				topic.name === 'Troubleshooting'
					? troubleshooting
					: troubleshooting.filter((entry) => entry.topics.includes(topic.name)),
		},
	}))
}

const { topic, description, guides, troubleshooting } = Astro.props
---

<Layout title={topic} description={description}>
	<Hero client:load title={topic} description={description} guides={[...guides, ...troubleshooting]}>
		<Breadcrumb slot="breadcrumb">
			<BreadcrumbList>
				<BreadcrumbItem>
					<BreadcrumbLink href={import.meta.env.BASE_URL}>Knowledge base</BreadcrumbLink>
				</BreadcrumbItem>
			</BreadcrumbList>
		</Breadcrumb>
	</Hero>
	<div class="flex flex-col gap-20 pb-24 pt-16 sm:gap-24 sm:pt-20">
		{
			guides.length === 0 && troubleshooting.length === 0 ? (
				<p class="mx-auto max-w-6xl px-6 text-sm text-foreground-light">No guides for this topic yet.</p>
			) : null
		}
		{guides.length > 0 ? <GuideBrowser client:load title="Guides" guides={guides} /> : null}
		{
			troubleshooting.length > 0 ? (
				<GuideBrowser client:load title="Troubleshooting" guides={troubleshooting} param="troubleshooting" />
			) : null
		}
	</div>
</Layout>
