---
import { getCollection } from 'astro:content'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList } from 'ui'

import { GuideBrowser } from '../../components/GuideBrowser'
import { Hero } from '../../components/Hero'
import Layout from '../../layouts/Layout.astro'
import { toSummary, toTroubleshootingSummary } from '../../lib/guides'
import { TOPICS, topicToSlug } from '../../lib/topics'

export async function getStaticPaths() {
	const guides = await getCollection('guides')
	const troubleshooting = await getCollection('troubleshooting')
	const summaries = [...guides.map(toSummary), ...troubleshooting.map(toTroubleshootingSummary)]

	// One page per topic in TOPICS — not just topics a guide already uses —
	// so every link on the "Topics" nav resolves instead of 404ing.
	return TOPICS.map((topic) => ({
		params: { topic: topicToSlug(topic.name) },
		props: {
			topic: topic.name,
			description: topic.description,
			guides: summaries.filter((summary) => summary.topics.includes(topic.name)),
		},
	}))
}

const { topic, description, guides } = Astro.props
---

<Layout title={topic} description={description}>
	<Hero client:load title={topic} description={description} guides={guides}>
		<Breadcrumb slot="breadcrumb">
			<BreadcrumbList>
				<BreadcrumbItem>
					<BreadcrumbLink href={import.meta.env.BASE_URL}>Knowledge base</BreadcrumbLink>
				</BreadcrumbItem>
			</BreadcrumbList>
		</Breadcrumb>
	</Hero>
	<div class="pb-24 pt-16 sm:pt-20">
		{
			guides.length === 0 ? (
				<p class="mx-auto max-w-6xl px-6 text-sm text-foreground-light">No guides for this topic yet.</p>
			) : (
				<GuideBrowser client:load title="Guides" guides={guides} />
			)
		}
	</div>
</Layout>
