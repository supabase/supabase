---
import { getCollection, render } from 'astro:content'
import { Admonition } from 'ui-patterns/Admonition'

import GuideLayout from '../../layouts/GuideLayout.astro'

export async function getStaticPaths() {
	const guides = await getCollection('guides')
	return guides.map((guide) => ({
		params: { slug: guide.id },
		props: { guide },
	}))
}

const { guide } = Astro.props
const { title, description, topics, github_url } = guide.data
const { Content } = await render(guide)

// guide.filePath is relative to the kb app root, e.g. "src/content/guides/foo.mdx"
const editLink = `https://github.com/supabase/supabase/blob/master/apps/kb/${guide.filePath}`
---

<GuideLayout title={title} description={description} topics={topics} github_url={github_url} editLink={editLink}>
	<Content components={{ Admonition }} />
</GuideLayout>
