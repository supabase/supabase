---
import { getCollection, render } from 'astro:content'
import { Admonition } from 'ui-patterns/Admonition'

import ArticleLayout from '../../layouts/ArticleLayout.astro'

export async function getStaticPaths() {
	const guides = await getCollection('guides')
	return guides.map((guide) => ({
		params: { slug: guide.id },
		props: { guide },
	}))
}

const { guide } = Astro.props
const { title, description, topics, github_url } = guide.data
const { Content } = await render(guide)
---

<ArticleLayout title={title} description={description} topics={topics} github_url={github_url}>
	<Content components={{ Admonition }} />
</ArticleLayout>
