---
import { ExternalLink } from 'lucide-react'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbSeparator, GithubIcon } from 'ui'
import type { TOCItemType } from 'ui-patterns/Toc/types'

import { GuideSidebar } from '../components/GuideSidebar'
import Layout from './Layout.astro'
import { getTopicDescription, isKnownTopic, topicToSlug } from '../lib/topics'

interface Props {
	title: string
	description?: string
	// string[], not Topic[]: federated collections (e.g. troubleshooting) pass
	// through their source's own topic tags unprocessed, which aren't
	// guaranteed to be members of kb's fixed Topic list.
	topics?: string[]
	github_url?: string
	viewGitHubLink?: string
	date?: string
	toc?: TOCItemType[]
}

const { title, description, topics = [], github_url, viewGitHubLink, date, toc = [] } = Astro.props
const pagePath = Astro.url.pathname.replace(/\/$/, '')
---

<Layout title={title} description={description}>
	<div class="section-container lg:flex lg:gap-12">
		<article class="prose prose-img:rounded-lg mx-auto max-w-3xl min-w-0 flex-1 py-16 lg:ml-(--nav-inset)">
			<Breadcrumb className="not-prose mb-6">
				<BreadcrumbList>
					<BreadcrumbItem>
						<BreadcrumbLink href={import.meta.env.BASE_URL}>Knowledge base</BreadcrumbLink>
					</BreadcrumbItem>
					{
						topics.length > 0 && (
							<>
								<BreadcrumbSeparator />
								{/* a guide can sit in several topics, so they share one level instead of nesting */}
								<BreadcrumbItem>
									{topics.map((topic, index) => (
										<span>
											{isKnownTopic(topic) ? (
												<BreadcrumbLink
													href={`${import.meta.env.BASE_URL}/topics/${topicToSlug(topic)}`}
													title={getTopicDescription(topic)}
												>
													{topic}
												</BreadcrumbLink>
											) : (
												topic
											)}
											{index < topics.length - 1 && ','}
										</span>
									))}
								</BreadcrumbItem>
							</>
						)
					}
				</BreadcrumbList>
			</Breadcrumb>
			<header class="mb-8">
				<h1 class="mt-0 mb-0 text-balance">{title}</h1>
				{date && <p class="not-prose mt-3 text-sm text-foreground-lighter">{date}</p>}
				{description && <p class="not-prose mt-3 text-xl leading-7 text-foreground-light">{description}</p>}
			</header>
			<slot />
			{
				github_url && (
					<p>
						<a href={github_url} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5">
							<GithubIcon size={16} /> Go to the GitHub discussion
						</a>
					</p>
				)
			}
			{
				viewGitHubLink && (
					<footer class="mt-16 not-prose">
						<a
							href={viewGitHubLink}
							target="_blank"
							rel="noreferrer noopener edit"
							class="w-fit inline-flex items-center gap-1 text-sm text-foreground-light hover:text-foreground"
						>
							View this page on GitHub <ExternalLink size={14} strokeWidth={1.5} />
						</a>
					</footer>
				)
			}
		</article>
		<aside class="sticky top-(--header-height) hidden max-h-[calc(100vh-var(--header-height))] w-60 shrink-0 self-start overflow-y-auto py-16 xl:block">
			<GuideSidebar
				client:load
				items={toc}
				pageUrl={new URL(pagePath, Astro.site).href}
				markdownUrl={`${pagePath}.md`}
			/>
		</aside>
	</div>
</Layout>
