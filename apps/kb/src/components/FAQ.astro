---
import { getEntry, render } from 'astro:content'
import { Admonition } from 'ui-patterns/Admonition'

interface Props {
	// Path of an entry in src/content/faqs, relative to that folder and without
	// the extension, e.g. "billing/refunds" for src/content/faqs/billing/refunds.mdx
	filePath: string
	// Level of the heading that shows the entry's title. Defaults to h2, since
	// the page layout already supplies the h1.
	headingLevel?: 1 | 2 | 3 | 4 | 5 | 6
}

const { filePath, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}` as const
const entry = await getEntry('faqs', filePath)
if (!entry) {
	throw new Error(`FAQ entry not found: src/content/faqs/${filePath}`)
}
const { Content } = await render(entry)
const { title } = entry.data
---

<Heading>{title}</Heading>
<Content components={{ Admonition }} />
