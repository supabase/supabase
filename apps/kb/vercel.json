{
  "buildCommand": "pnpm build",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/kb", "permanent": false },
    { "source": "/kb/sitemap.md", "destination": "/kb/markdown/sitemap.md", "permanent": true },
    {
      "source": "/kb/guides/:path+.md",
      "destination": "/kb/markdown/guides/:path+.md",
      "permanent": true
    },
    {
      "source": "/kb/topics/:path+.md",
      "destination": "/kb/markdown/topics/:path+.md",
      "permanent": true
    },
    {
      "source": "/kb/troubleshooting/:path+.md",
      "destination": "/kb/markdown/troubleshooting/:path+.md",
      "permanent": true
    },
    {
      "source": "/kb/faqs/:path+.md",
      "destination": "/kb/markdown/faqs/:path+.md",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/kb/guides/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/markdown/guides/:path+.md"
    },
    {
      "source": "/kb/topics/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/markdown/topics/:path+.md"
    },
    {
      "source": "/kb/troubleshooting/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/markdown/troubleshooting/:path+.md"
    },
    {
      "source": "/kb/faqs/:path+",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/markdown/faqs/:path+.md"
    },
    { "source": "/kb", "destination": "/index.html" },
    { "source": "/kb/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/kb/guides/:path+",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/kb/topics/:path+",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/kb/troubleshooting/:path+",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/kb/faqs/:path+",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    }
  ]
}
