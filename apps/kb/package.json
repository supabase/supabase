{
  "name": "kb",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 3008",
    "prebuild": "pnpm run fetch:federated-content && pnpm run generate:markdown",
    "build": "astro build",
    "fetch:federated-content": "tsx ./scripts/federated-content/fetch-federated-content.ts",
    "generate:markdown": "tsx ./scripts/generate-markdown.mjs",
    "sync:legacy-slugs": "tsx ./scripts/federated-content/backfill-legacy-slugs.ts",
    "sync:troubleshooting-entries": "tsx ./scripts/federated-content/sync-troubleshooting-entries.ts",
    "sync:troubleshooting-updates": "tsx ./scripts/federated-content/sync-troubleshooting-updates.ts",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest --run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.4",
    "@octokit/auth-app": "^7.0.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^8.1.0",
    "@supabase/supabase-js": "catalog:",
    "astro": "^7.2.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.4",
    "ui": "workspace:*",
    "ui-patterns": "workspace:*",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "config": "workspace:*",
    "lodash-es": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "allowScripts": {
    "esbuild": true
  }
}
