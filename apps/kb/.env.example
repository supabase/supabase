# GitHub auth for scripts/federated-content/fetch-federated-content.ts (pulls
# troubleshooting content from the private supabase/troubleshooting repo).
# Same credentials as apps/docs — that GitHub App must also be granted
# access to supabase/troubleshooting.
#
# Preferred: a GitHub App installation. Set all three or none.
KB_GITHUB_APP_ID=
KB_GITHUB_APP_INSTALLATION_ID=
KB_GITHUB_APP_PRIVATE_KEY=

# Fallback for local dev if the App isn't configured: a personal access
# token, e.g. `export GH_TOKEN=$(gh auth token)`.
GH_TOKEN=

# Supabase project backing troubleshooting_entries (same project apps/www and
# apps/studio use — supabase/config.toml's `[remotes.prod]`). Everything in kb
# uses the service role key: the Astro build reads with it, the sync scripts
# also write. Never expose it to client code (kb is static, build-time only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project backing kb search (docs-search's docs_sections table, see
# packages/docs-search/sql/setup.sql). Written by `pnpm search:ingest`. Kept
# separate from SUPABASE_URL above so ingest can never write to that project.
KB_SEARCH_SUPABASE_URL=
KB_SEARCH_SUPABASE_SECRET_KEY=
