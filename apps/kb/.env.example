# GitHub auth for scripts/federated-content/fetch-federated-content.ts (pulls
# troubleshooting content from the private supabase/troubleshooting repo).
# Same credentials as apps/docs — that GitHub App must also be granted
# access to supabase/troubleshooting.
#
# Preferred: a GitHub App installation. Set all three or none.
DOCS_GITHUB_APP_ID=
DOCS_GITHUB_APP_INSTALLATION_ID=
DOCS_GITHUB_APP_PRIVATE_KEY=

# Fallback for local dev if the App isn't configured: a personal access
# token, e.g. `export GH_TOKEN=$(gh auth token)`.
GH_TOKEN=
