# Copy this file to supabase/functions/.env before serving locally:
#   cp supabase/functions/mcp-server/.env.example supabase/functions/.env
#   supabase functions serve mcp-server --env-file supabase/functions/.env

# Keep the protocol-level server name short and project-specific.
MCP_SERVER_NAME=supabase-mcp
MCP_SERVER_DESCRIPTION="MCP access to this Supabase project for the signed-in user."

# Accept first-party Supabase user JWTs in addition to OAuth tokens. Set this to
# "false" to require an audience-bound OAuth token, which is what external MCP
# clients send. Leaving it true is useful during setup, because a first-party
# token can be tested with curl.
MCP_ALLOW_FIRST_PARTY_JWT=true

# Which toolsets to register, comma-separated. Unset registers all of them.
# MCP_TOOLSETS=echo,whoami,postgrest
