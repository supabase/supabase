{
  "manifest_version": 3,
  "name": "Supabase Dev Tools",
  "version": "0.1.0",
  "description": "Supabase developer tools — run Studio locally against a hosted backend, syncing your dashboard session to localhost.",
  "homepage_url": "https://github.com/supabase/supabase/tree/master/apps/studio/scripts/dev-tools-extension",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://supabase.com/*",
    "https://supabase.green/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Supabase auth to local Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
