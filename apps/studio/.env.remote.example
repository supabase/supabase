# Remote-dev config: run Studio locally (with HMR) against a HOSTED Supabase backend.
#
# Usage:
#   cp apps/studio/.env.remote.example apps/studio/.env.local
#   # fill in REMOTE_GOTRUE_URL below, then:
#   pnpm dev:studio          # → http://localhost:8082
#   # sign in with your real Supabase account; your real projects appear.
#
# Fastest way to a session (skips the sign-in form + hCaptcha, which is
# domain-locked to the hosted dashboard): while logged into supabase.com/dashboard,
# copy the localStorage value under `supabase.dashboard.auth.token` and set the
# same key on http://localhost:8082. Studio picks it up; auth-js then refreshes it
# against REMOTE_GOTRUE_URL below (which is why that value must be correct).
#
# How it works: NEXT_PUBLIC_* point Studio's clients at same-origin paths on the
# local dev server; REMOTE_DEV rewrites (next.config.ts) proxy those paths to the
# hosted backend server-side, so the browser never makes a cross-origin request
# (no CORS) and the bearer token is forwarded upstream. See REMOTE_DEV.md.
#
# ⚠️  This points local dev at PRODUCTION projects. Treat every action as real.
#     Prefer a throwaway/staging project while iterating. A REMOTE indicator and
#     guardrails are recommended before wider use (see REMOTE_DEV.md §Safety).

# --- turn on platform mode + the proxy ---
NEXT_PUBLIC_IS_PLATFORM=true
REMOTE_DEV=true

# --- where the proxy forwards to (server-side) ---
# Hosted control-plane API origin (production default).
REMOTE_API_URL=https://api.supabase.com
# Hosted dashboard GoTrue base URL (the auth service for Supabase *accounts*, not
# a project's GoTrue). This is the `iss` claim of a real dashboard token and what
# the hosted dashboard uses for NEXT_PUBLIC_GOTRUE_URL. Production value:
REMOTE_GOTRUE_URL=https://alt.supabase.io/auth/v1

# --- Studio client config (same-origin; caught by the rewrites above) ---
# API_URL logic strips the trailing `/platform`, so the openapi client's baseUrl
# becomes http://localhost:8082 and requests to /platform/* and /v1/* stay same-origin.
NEXT_PUBLIC_API_URL=http://localhost:8082/platform
# auth-js talks to /auth/v1 same-origin; the rewrite forwards it to REMOTE_GOTRUE_URL.
NEXT_PUBLIC_GOTRUE_URL=http://localhost:8082/auth/v1
NEXT_PUBLIC_SITE_URL=http://localhost:8082
