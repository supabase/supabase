{
  "$schema": "./../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:content": {
      "outputs": [".velite/**"],
    },
    // Watches the MDX content next to `next dev`. Waits for the one-off content build so the
    // two don't write .velite at the same time.
    "dev:content": {
      "dependsOn": ["build:content"],
      "cache": false,
      "persistent": true,
    },
    "dev": {
      "dependsOn": ["build:content"],
      "with": ["dev:content"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build:content"],
    },
    "build": {
      "dependsOn": ["^build", "build:content"],
      "env": ["NODE_ENV"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**/*", "!.next/dev/**/*"],
    },
  },
}
