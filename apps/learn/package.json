{
  "name": "learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:content": "maybe-turbo velite dev",
    "dev": "maybe-turbo next dev --port 3007",
    "build": "maybe-turbo next build --turbopack",
    "build:content": "velite build --strict",
    "internal:sync": "tsx ./scripts/sync-internal-content.mts",
    "start": "next start",
    "lint": "eslint .",
    "lint:ratchet": "tsx node_modules/eslint-config-supabase/ratchet-eslint-rules.ts --rules-file node_modules/eslint-config-supabase/ratchet-rules.json",
    "clean": "rimraf .next .turbo tsconfig.tsbuildinfo .contentlayer .velite tsconfig.tsbuildinfo",
    "typecheck": "maybe-turbo tsc --noEmit"
  },
  "dependencies": {
    "common": "workspace:*",
    "jotai": "^2.8.0",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-wrap-balancer": "^1.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "catalog:",
    "rehype-slug": "^6.0.0",
    "remark": "^14.0.3",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.0",
    "ui": "workspace:*",
    "ui-patterns": "workspace:*",
    "unist-util-visit": "^5.0.0",
    "velite": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "config": "workspace:^",
    "eslint-config-supabase": "workspace:*",
    "maybe-turbo": "workspace:*",
    "mdast-util-toc": "^6.1.1",
    "npm-run-all": "^4.1.5",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "tsconfig": "workspace:*",
    "tsx": "catalog:"
  }
}
