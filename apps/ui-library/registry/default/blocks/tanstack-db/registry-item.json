{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tanstack-db-nextjs",
  "type": "registry:block",
  "title": "TanStack DB for Next.js and Supabase",
  "description": "TanStack DB integration with Supabase collections for type-safe database operations",
  "registryDependencies": ["button", "input", "label", "sheet"],
  "dependencies": [
    "supa-tdb-collection@latest",
    "zod@latest",
    "@tanstack/db@latest",
    "@tanstack/react-db@latest"
  ],
  "files": [],
  "docs": "This block provides TanStack DB integration with Supabase collections. The schemas and collections are generated based on your database schema.",
  "meta": {
    "architecture": {
      "resources": [
        {
          "id": "generated-collections",
          "kind": "capability",
          "label": "Typed collections",
          "description": "Generated from the tables you select"
        },
        {
          "id": "generated-schemas",
          "kind": "capability",
          "label": "Zod schemas",
          "description": "Generated from your database schema"
        },
        {
          "id": "existing-database",
          "kind": "service",
          "label": "Supabase Database",
          "description": "Uses your existing tables",
          "status": "existing"
        }
      ],
      "relationships": [
        {
          "source": "generated-collections",
          "target": "generated-schemas",
          "label": "Validates records"
        },
        {
          "source": "generated-collections",
          "target": "existing-database",
          "label": "Queries selected tables"
        }
      ]
    }
  }
}
