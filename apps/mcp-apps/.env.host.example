# Copy to .env.host (git-ignored). Read by `pnpm dev:e2e` and the host.

# Your Supabase personal access token, for --platform=api (the default).
# Not needed for --platform=mock.
SUPABASE_ACCESS_TOKEN=

# Optional: query parameters select features, read-only mode or a project scope,
# exactly as for the hosted server, e.g. ?read_only=true&project_ref=abcdefghijklmnopqrst
MCP_SERVER_URL=http://127.0.0.1:3111/mcp

# The model the host chats with, as <provider>:<model>. Leave empty to run
# tools by hand. Providers:
#   bedrock            AWS credentials from the default provider chain (AWS_PROFILE, SSO, env), AWS_REGION
#   anthropic          ANTHROPIC_API_KEY or HOST_MODEL_API_KEY
#   openai             OPENAI_API_KEY or HOST_MODEL_API_KEY
#   openai-compatible  any OpenAI-compatible endpoint (vLLM, Ollama, an internal gateway) at HOST_MODEL_BASE_URL
HOST_MODEL=
HOST_MODEL_BASE_URL=
HOST_MODEL_API_KEY=
