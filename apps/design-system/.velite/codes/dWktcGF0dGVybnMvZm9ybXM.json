State<File[]>([])\\n  const [isDragging, setIsDragging] = useState(false)\\n\\n  const form = useForm<z.infer<typeof formSchema>>({\\n    resolver: zodResolver(formSchema),\\n    defaultValues: {\\n      name: '',\\n      description: '',\\n      maxConnections: 10,\\n      enableFeature: false,\\n      enableRls: true,\\n      enableNotifications: false,\\n      enableAnalytics: true,\\n      region: '',\\n      schemas: ['public'],\\n      queueType: 'basic',\\n      expiryDate: undefined,\\n      password: '',\\n      duration: 10,\\n      redirectUris: [{ value: '' }],\\n      httpHeaders: [{ key: '', value: '' }],\\n      apiKey: fakeApiKey,\\n    },\\n  })\\n\\n  function onSubmit(values: z.infer<typeof formSchema>) {\\n    console.log(values)\\n  }\\n\\n  return (\\n    <div className=\\\"w-full\\\">\\n      <PageSection className=\\\"py-0\\\">\\n        <PageSectionMeta>\\n          <PageSectionSummary>\\n            <PageSectionTitle>Form Settings</PageSectionTitle>\\n          </PageSectionSummary>\\n        </PageSectionMeta>\\n        <PageSectionContent>\\n          <Form {...form}>\\n            <form onSubmit={form.handleSubmit(onSubmit)}>\\n              <Card>\\n                {/* Text Input */}\\n                <CardContent>\\n                  <FormField\\n                    control={form.control}\\n                    name=\\\"name\\\"\\n                    render={({ field }) => (\\n                      <FormItemLayout\\n                        layout=\\\"flex-row-reverse\\\"\\n                        label=\\\"Text Input\\\"\\n                        description=\\\"Single-line text entry for short values\\\"\\n                      >\\n                        <FormControl>\\n                          <Input {...field} placeholder=\\\"Enter text\\\" />\\n                        </FormControl>\\n                      </FormItemLayout>\\n                    )}\\n                  />\\n                </CardContent>\\n\\n                {/* Password Input */}\\n                <CardContent>\\n                  <FormField\\n                    control={form.control}\\n                    name=\\\"password\\\"\\n                    render={({ field }) => (\\n                      <FormItemLayout\\n                        layout=\\\"flex-row-reverse\\\"\\n                        label=\\\"Password Input\\\"\\n                        description=\\\"Masked input for secure text entry\\\"\\n                      >\\n                        <FormControl>\\n                          <Input {...field} type=\\\"password\\\" placeholder=\\\"Enter password\\\" />\\n                        </FormControl>\\n                      </FormItemLayout>\\n                    )}\\n                  />\\n                </CardContent>\\n\\n                {/* Copyable Input */}\\n                <CardContent>\\n                  <FormField\\n                    control={form.control}\\n                    name=\\\"apiKey\\\"\\n                    render={() => (\\n                      <FormItemLayout\\n                        layout=\\\"flex-row-reverse\\\"\\n                        label=\\\"Copyable Input\\\"\\n                        description=\\\"Read-only input with copy-to-clipboard functionality\\\"\\n                      >\\n                        <FormControl>\\n                          <PasswordInput\\n                            copy\\n                            readOnly\\n                            value={form.getValues('apiKey') || ''}\\n                            onChange={() => {}}\\n                            onCopy={() => console.log('Copied to clipboard')}\\n                          />\\n                        </FormControl>\\n                      </FormItemLayout>\\n                    )}\\n                  />\\n                </CardContent>\\n\\n                {/* Number Input */}\\n                <CardContent>\\n                  <FormField\\n                    control={form.control}\\n 