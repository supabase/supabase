# Supabase project used by the community-docs quality sync and Auth dashboard.
# Prefer a Supabase branch of your project during local testing.

# Browser Auth + dashboard reads (publishable / anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role writes for scripts/sync-repos-to-supabase.ts only. Never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. GH_TOKEN or GITHUB_TOKEN is passed through to the `gh` CLI used by fetch-content and the sync script.
# Not required locally if you've already run `gh auth login`.
GH_TOKEN=

# Required for LLM-assisted fetch-content. When unset, fetch-content falls back to keyword inference
# and prints a one-line warning. Warm cache runs (no repo changes since last sync) do not call the LLM.
# Model used: claude-haiku-4-5.
ANTHROPIC_API_KEY=
