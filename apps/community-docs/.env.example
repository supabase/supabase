# Supabase project used by the community-docs quality sync (scripts/sync-repos-to-supabase.ts).
# Prefer a Supabase branch of your project during local testing; use the prod project via GH Actions secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. GH_TOKEN or GITHUB_TOKEN is passed through to the `gh` CLI used by fetch-content and the sync script.
# Not required locally if you've already run `gh auth login`.
GH_TOKEN=
