# Template for per-database PostgREST clusters
# Generated by scripts/generate-envoy-clusters.py
# This template shows the structure for a single cluster entry.
# The actual CDS file is generated by scripts/generate-envoy-clusters.py.
resources:
  - "@type": type.googleapis.com/envoy.config.cluster.v3.Cluster
    name: rest-{ref}
    type: STRICT_DNS
    connect_timeout: 15s
    dns_lookup_family: V4_ONLY
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: rest-{ref}
      endpoints:
        - lb_endpoints:
            - endpoint:
                address:
                  socket_address:
                    address: supabase-rest-{ref}
                    port_value: 3000