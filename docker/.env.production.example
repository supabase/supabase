# =============================================================================
# Supabase Self-Hosted — Production Environment Variables
# In Dokploy: paste these into the Environment Variables panel.
# =============================================================================

# Domains
API_DOMAIN=api.yourdomain.com
STUDIO_DOMAIN=studio.yourdomain.com
API_EXTERNAL_URL=https://api.yourdomain.com
SUPABASE_PUBLIC_URL=https://api.yourdomain.com
SITE_URL=https://yourdomain.com

# Secrets — CHANGE ALL OF THESE
POSTGRES_PASSWORD=change-me-strong-postgres-password
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
PG_META_CRYPTO_KEY=change-me-32-char-hex-openssl-rand-hex-16
SECRET_KEY_BASE=change-me-64-char-random-string
VAULT_ENC_KEY=change-me-32-chars-exactly

# Studio dashboard auth
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-strong-password

# Optional: per-project database passwords
DB_ALPHA_PASSWORD=
DB_ALPHA_JWT_SECRET=
DB_ALPHA_ANON_KEY=
DB_ALPHA_SERVICE_KEY=
DB_BETA_PASSWORD=
DB_BETA_JWT_SECRET=
DB_BETA_ANON_KEY=
DB_BETA_SERVICE_KEY=

# Pooler external access
POOLER_PORT_SESSION=6543
POOLER_PORT_TRANSACTION=5432

# PostgREST schemas
PGRST_DB_SCHEMAS=public,storage,graphql_public
JWT_EXPIRY=3600
