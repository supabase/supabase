{
  "name": "supabase-management-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local management API for self-hosted Supabase: runtime Auth (GoTrue) configuration and email templates",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@react-email/components": "^0.0.31",
    "@react-email/render": "^1.0.3",
    "esbuild": "^0.24.2",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
