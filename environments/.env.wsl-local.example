# =============================================================
# بيئة WSL المحلية — WSL Local Environment
# انسخ هذا الملف إلى .env.wsl-local وعبّئ القيم الحقيقية
# =============================================================

# --- معرّف البيئة ---
KIRO_ENV=wsl-local
WORKSPACE_ROOT=/home/YOUR_USERNAME/project

# --- قاعدة البيانات (محلية عبر Docker Desktop) ---
DB_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/postgres

# --- Supabase (محلي عبر Docker) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ACCESS_TOKEN=your-local-supabase-access-token
SUPABASE_PROJECT_REF=your-local-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_AUTHOR_NAME=Your Full Name
GIT_AUTHOR_EMAIL=your@email.com

# --- MCP: تعطيل سيرفرات السحابة في البيئة المحلية ---
AWS_MCP_DISABLED=true
AZURE_MCP_DISABLED=true

# --- إعدادات Node.js ---
NODE_ENV=development
PORT=3000

# --- WSL خاص ---
# مسار Docker socket في WSL
DOCKER_HOST=unix:///var/run/docker.sock
