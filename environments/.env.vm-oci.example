# =============================================================
# بيئة OCI VM — Oracle Cloud Infrastructure VM
# انسخ هذا الملف إلى .env.vm-oci وعبّئ القيم الحقيقية
# الأسرار الحساسة: احفظها في OCI Vault وليس هنا
# =============================================================

# --- معرّف البيئة ---
KIRO_ENV=vm-oci
WORKSPACE_ROOT=/home/opc/project

# --- OCI Configuration ---
OCI_REGION=me-jeddah-1
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=~/.oci/oci_api_key.pem
# أو استخدم Instance Principal (لا تحتاج مفاتيح)
OCI_USE_INSTANCE_PRINCIPAL=false

# --- قاعدة البيانات (Oracle DB / MySQL HeatWave / PostgreSQL) ---
DB_CONNECTION_STRING=postgresql://dbuser:CHANGE_ME@your-db-host.oraclevcn.com:5432/dbname
DB_HOST=your-db-host.oraclevcn.com
DB_PORT=5432
DB_NAME=dbname
DB_USER=dbuser
# DB_PASSWORD: استرجعه من OCI Vault في runtime

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_AUTHOR_NAME=Your Full Name
GIT_AUTHOR_EMAIL=your@email.com

# --- MCP: تعطيل AWS و Azure ---
AWS_MCP_DISABLED=true
AZURE_MCP_DISABLED=true

# --- إعدادات التطبيق ---
NODE_ENV=production
PORT=3000

# --- OCI Vault (أسماء الأسرار فقط — لا قيم) ---
OCI_VAULT_OCID=ocid1.vault.oc1..xxxxxxxx
SECRET_DB_PASSWORD_OCID=ocid1.vaultsecret.oc1..xxxxxxxx
SECRET_GITHUB_TOKEN_OCID=ocid1.vaultsecret.oc1..xxxxxxxx

# --- OCI Object Storage (S3-compatible) ---
OCI_OBJECT_STORAGE_NAMESPACE=your-namespace
OCI_BUCKET_NAME=your-bucket
OCI_S3_ENDPOINT=https://your-namespace.compat.objectstorage.me-jeddah-1.oraclecloud.com
# S3-compatible keys (من OCI Console > Customer Secret Keys)
OCI_S3_ACCESS_KEY=your-oci-s3-access-key
# OCI_S3_SECRET_KEY: احفظه في OCI Vault
