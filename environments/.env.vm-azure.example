# =============================================================
# بيئة Azure VM (IaaS) — Azure Virtual Machine
# انسخ هذا الملف إلى .env.vm-azure وعبّئ القيم الحقيقية
# الأسرار الحساسة: احفظها في Azure Key Vault وليس هنا
# =============================================================

# --- معرّف البيئة ---
KIRO_ENV=vm-azure
WORKSPACE_ROOT=/home/azureuser/project

# --- Azure Identity ---
AZURE_LOCATION=eastus
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=my-resource-group
AZURE_VM_NAME=my-vm

# Managed Identity (الموصى به — فعّلها من Azure Portal على الـ VM)
AZURE_USE_MANAGED_IDENTITY=true
# إذا لم تكن Managed Identity متاحة، استخدم Service Principal:
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET: احفظه في Key Vault وليس هنا

# --- قاعدة البيانات (Azure Database for PostgreSQL / SQL) ---
DB_CONNECTION_STRING=postgresql://dbuser@server:CHANGE_ME@server.postgres.database.azure.com:5432/dbname?sslmode=require
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=dbname
DB_USER=dbuser@your-server
# DB_PASSWORD: استرجعه من Key Vault في runtime

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_AUTHOR_NAME=Your Full Name
GIT_AUTHOR_EMAIL=your@email.com

# --- MCP: تعطيل AWS وتفعيل Azure ---
AWS_MCP_DISABLED=true
AZURE_MCP_DISABLED=false

# --- إعدادات التطبيق ---
NODE_ENV=production
PORT=3000

# --- Azure Key Vault ---
KEYVAULT_NAME=my-keyvault
KEYVAULT_URI=https://my-keyvault.vault.azure.net/
SECRET_DB_PASSWORD_NAME=db-password
SECRET_GITHUB_TOKEN_NAME=github-token

# --- Azure Blob Storage ---
STORAGE_ACCOUNT_NAME=mystorageaccount
STORAGE_CONTAINER_NAME=mycontainer

# --- Azure Monitor ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
