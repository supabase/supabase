# =============================================================
# بيئة AWS Cloud — AWS Cloud Environment
# انسخ هذا الملف إلى .env.aws-cloud وعبّئ القيم الحقيقية
# الأسرار الحساسة: احفظها في AWS Secrets Manager وليس هنا
# =============================================================

# --- معرّف البيئة ---
KIRO_ENV=aws-cloud
WORKSPACE_ROOT=/home/ec2-user/project

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default
# لا تضع AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY هنا
# استخدم IAM Instance Profile بدلاً من ذلك

# --- قاعدة البيانات (RDS / Aurora) ---
DB_CONNECTION_STRING=postgresql://dbuser:CHANGE_ME@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/dbname
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=dbname
DB_USER=dbuser
# DB_PASSWORD: استرجعه من Secrets Manager في runtime

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_AUTHOR_NAME=Your Full Name
GIT_AUTHOR_EMAIL=your@email.com

# --- MCP: تفعيل AWS وتعطيل Azure ---
AWS_MCP_DISABLED=false
AZURE_MCP_DISABLED=true

# --- إعدادات التطبيق ---
NODE_ENV=production
PORT=3000

# --- AWS Secrets Manager (أسماء الأسرار فقط — لا قيم) ---
SECRET_DB_PASSWORD_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:prod/db/password
SECRET_GITHUB_TOKEN_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:prod/github/token

# --- S3 ---
S3_BUCKET_NAME=your-app-bucket
S3_REGION=us-east-1
